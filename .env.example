# Public project configuration only. Never put a service-role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
API_PORT=5174
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional server-only OpenAI-compatible structured extraction provider.
# Never expose these values through VITE_ variables or browser code.
SENTINEL_AI_ENDPOINT=
SENTINEL_AI_KEY=
SENTINEL_AI_MODEL=

# Staging uses same-origin /api requests. Vercel deployment hostnames are
# allowlisted automatically; list any later custom frontend origins above.
