{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env.local server/index.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "test:api": "node --test --test-isolation=none server/app.test.ts server/auth-callback.test.ts",
    "test:frontend": "node --test --test-isolation=none src/lib/connected-projects.test.ts src/lib/connected-shell.test.ts",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
